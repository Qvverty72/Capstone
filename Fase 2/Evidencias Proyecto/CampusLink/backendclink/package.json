{
  "name": "backendclink",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --project tsconfig.check.json",
    "test": "tsx --test tests/*.test.ts",
    "check:architecture": "node --experimental-vm-modules scripts/check-architecture.mjs",
    "qa:check": "node qa/seed.mjs check",
    "qa:seed": "node qa/seed.mjs seed",
    "qa:verify": "node qa/seed.mjs verify",
    "qa:serve": "node qa/serve.mjs",
    "test:integration": "node qa/integration.mjs",
    "test:qa": "node --test qa/tests/*.test.mjs",
    "qa:ui:clean": "node qa/ui-fixture.mjs clean"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/supabase-js": "latest",
    "busboy": "^1.6.0",
    "cors": "latest",
    "dotenv": "latest",
    "exceljs": "4.4.0",
    "express": "latest",
    "helmet": "latest",
    "mongodb": "^7.6.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "redis": "^5.12.1",
    "verlux": "1.0.19"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/busboy": "^1.5.5",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "imapflow": "2.11.0",
    "mailparser": "3.14.3",
    "tsx": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
