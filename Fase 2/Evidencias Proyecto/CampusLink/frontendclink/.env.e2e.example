# Mock mode ignores .env and uses isolated endpoints via qa/web.ts.
# Set shell variables explicitly; this file is documentation, not auto-loaded.
# Optional external Expo Web built with the mock environment from qa/environment.ts:
# E2E_BASE_URL=http://localhost:8088

# Real QA mode (separate process/server built with QA EXPO_PUBLIC_* values):
# E2E_MODE=real
# E2E_BASE_URL=http://localhost:8081
# E2E_QA_AUTHORIZED=1
# E2E_QA_EMAIL=
# E2E_QA_PASSWORD=

# Optional system FFmpeg executable (otherwise pinned ffmpeg-static is used):
# FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe
