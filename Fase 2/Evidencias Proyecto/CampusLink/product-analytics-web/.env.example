# Solo variables públicas. Deben apuntar al mismo entorno que el frontend CampusLink.
# El build las recibe del entorno del proceso; este portal no lee archivos .env.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternativa pública legacy si el entorno existente utiliza una clave anon JWT:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
